# Copie este archivo a .env y complete los valores. .env no se sube al repositorio.

# PostgreSQL local con Docker (`docker compose up -d db` desde la raíz): puerto 5433, ambas URL iguales.
DATABASE_URL=postgresql://garweb:garweb@localhost:5433/garweb
DIRECT_URL=postgresql://garweb:garweb@localhost:5433/garweb

# Supabase (ver backend/README.md, "Desplegar en Supabase"): en el panel, botón "Connect".
#   DATABASE_URL = "Transaction pooler" (puerto 6543) + ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = "Session pooler" o "Direct connection" (puerto 5432)
# DATABASE_URL=postgresql://postgres.<ref>:<CONTRASEÑA>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://postgres.<ref>:<CONTRASEÑA>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Secretos de JWT: cadenas aleatorias de 32+ caracteres, distintas entre sí.
# Genérelas con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_MINUTOS=15
JWT_REFRESH_DIAS=30

PORT=3000
# URL del frontend (CORS y enlace de recuperación)
APP_URL=http://localhost:5173

# Correo. Sin SMTP_HOST los correos se imprimen en la consola del backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=GARWEB <no-reply@garwood.com>

# Contraseña de los usuarios de prueba que crea `npm run db:seed` (solo desarrollo)
SEED_CONTRASENA=Sofa2026

# Fotos y videos de las solicitudes. disco = carpeta UPLOADS_DIR (en Docker, el volumen garweb-uploads).
# supabase = bucket privado de Supabase Storage (complete SUPABASE_URL y SUPABASE_SECRET_KEY; nunca en el frontend).
STORAGE=disco
UPLOADS_DIR=uploads
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SECRET_KEY=
STORAGE_BUCKET=garweb-archivos
