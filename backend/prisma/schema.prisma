// Esquema de GARWEB — Seguridad (CU-S01, S02), Cliente (CU-H01) y Solicitud de cotización (CU-C01).
// Convención de la tesis: tablas y columnas en snake_case y en español (@@map / @map).

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL: conexión de la app (en Supabase, el pooler en el puerto 6543).
// DIRECT_URL: conexión directa para migraciones (en Supabase, el puerto 5432). En Docker ambas son iguales.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Rol {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique @db.VarChar(40)
  permisos Json      @default("[]")
  usuarios Usuario[]

  @@map("rol")
}

model Usuario {
  id                    Int                    @id @default(autoincrement())
  clienteId             Int?                   @unique @map("cliente_id")
  rolId                 Int                    @map("rol_id")
  // No se puede cambiar: identifica a la persona en la bitácora (decisiones D.1.4).
  nombreUsuario         String                 @unique @map("nombre_usuario") @db.VarChar(120)
  // Nombre visible del personal (A20). Los clientes usan el nombre de su ficha de cliente.
  nombre                String?                @db.VarChar(80)
  // Para recuperar la contraseña (CU-S02). Obligatorio para Administrador y Cliente; opcional para
  // Producción y Conductor (decisiones D.1.2): esa regla se valida en el backend.
  email                 String?                @unique @db.VarChar(160)
  contrasenaHash        String                 @map("contrasena_hash")
  // Computadora | Celular | Tablet (solo informativo, decisiones D.1.7).
  dispositivo           String?                @db.VarChar(20)
  activo                Boolean                @default(true)
  // Bloqueo por intentos fallidos (CU-S01).
  intentosFallidos      Int                    @default(0) @map("intentos_fallidos")
  bloqueadoHasta        DateTime?              @map("bloqueado_hasta") @db.Timestamptz
  // Contraseña temporal dada por el Administrador: se cambia en el primer ingreso (D.1.3).
  debeCambiarContrasena Boolean                @default(false) @map("debe_cambiar_contrasena")
  // Sube al desactivar, cambiar el rol o la contraseña; una sesión con un número viejo ya no se renueva (D.1.6).
  versionSesion         Int                    @default(0) @map("version_sesion")
  fechaCreacion         DateTime               @default(now()) @map("fecha_creacion") @db.Timestamptz
  rol                   Rol                    @relation(fields: [rolId], references: [id])
  cliente               Cliente?               @relation(fields: [clienteId], references: [id])
  tokens                TokenRecuperacion[]
  cambiosCorreo         CambioCorreo[]
  bitacora              Bitacora[]
  solicitudes           Solicitud[]
  descartadas           Solicitud[]            @relation("SolicitudDescartadaPor")
  notificaciones        Notificacion[]
  citas                 Cita[]
  parametrosModificados Parametro[]            @relation("ParametroModificadoPor")
  cambiosParametro      ParametroHistorial[]
  movimientos           MovimientoInventario[]
  compras               Compra[]               @relation("CompraRegistradaPor")
  comprasRecibidas      Compra[]               @relation("CompraRecibidaPor")
  conteos               Conteo[]

  @@map("usuario")
}

model Cliente {
  id                 Int         @id @default(autoincrement())
  tipoPersona        String      @map("tipo_persona") @db.VarChar(10) // persona | empresa
  nombres            String      @db.VarChar(80)
  apellidos          String      @db.VarChar(80)
  razonSocial        String?     @map("razon_social") @db.VarChar(160)
  documento          String?     @unique @db.VarChar(20) // EIN de la empresa
  cargo              String?     @db.VarChar(80)
  // Opcional: el Administrador puede registrar por teléfono a un cliente que no tiene correo (A3).
  email              String?     @unique @db.VarChar(160)
  telefono           String      @db.VarChar(20) // E.164: +1XXXXXXXXXX
  // W10 (decisiones E.3): avisos INFORMATIVOS por correo (avance, cotización, pagos). Los obligatorios llegan siempre.
  aceptaAvisosCorreo Boolean     @default(true) @map("acepta_avisos_correo")
  // W10: "Recordatorios y novedades del taller". Por ahora solo se guarda (promociones a futuro); viene apagado.
  aceptaNovedades    Boolean     @default(false) @map("acepta_novedades")
  canalRegistro      String      @map("canal_registro") @db.VarChar(20) // web | local | telefono
  activo             Boolean     @default(true)
  fechaRegistro      DateTime    @default(now()) @map("fecha_registro") @db.Timestamptz
  usuario            Usuario?
  direcciones        Direccion[]
  solicitudes        Solicitud[]
  pedidos            Pedido[]

  @@map("cliente")
}

model TokenRecuperacion {
  id              Int       @id @default(autoincrement())
  usuarioId       Int       @map("usuario_id")
  // Solo se guarda el SHA-256 del token; el token en claro viaja únicamente en el correo.
  tokenHash       String    @unique @map("token_hash") @db.Char(64)
  fechaExpiracion DateTime  @map("fecha_expiracion") @db.Timestamptz
  fechaUso        DateTime? @map("fecha_uso") @db.Timestamptz
  fechaCreacion   DateTime  @default(now()) @map("fecha_creacion") @db.Timestamptz
  usuario         Usuario   @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("token_recuperacion")
}

// W10 (decisiones E.1.4): el cliente pidió cambiar su correo. El cambio se aplica recién cuando abre el enlace enviado
// al correo nuevo; mientras tanto sigue entrando con el de siempre. Un pedido nuevo anula el anterior (fecha_uso).
model CambioCorreo {
  id              Int       @id @default(autoincrement())
  usuarioId       Int       @map("usuario_id")
  emailNuevo      String    @map("email_nuevo") @db.VarChar(160)
  // Solo el SHA-256 del token; el token en claro viaja únicamente en el correo.
  tokenHash       String    @unique @map("token_hash") @db.Char(64)
  fechaExpiracion DateTime  @map("fecha_expiracion") @db.Timestamptz
  fechaUso        DateTime? @map("fecha_uso") @db.Timestamptz
  confirmado      Boolean   @default(false)
  fechaCreacion   DateTime  @default(now()) @map("fecha_creacion") @db.Timestamptz
  usuario         Usuario   @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("cambio_correo")
}

// RG-02: auditoría total.
model Bitacora {
  id            Int      @id @default(autoincrement())
  usuarioId     Int?     @map("usuario_id")
  modulo        String   @db.VarChar(30)
  accion        String   @db.VarChar(60)
  entidad       String   @db.VarChar(60)
  entidadId     Int?     @map("entidad_id")
  valorAnterior Json?    @map("valor_anterior")
  valorNuevo    Json?    @map("valor_nuevo")
  ip            String?  @db.VarChar(45)
  fecha         DateTime @default(now()) @db.Timestamptz
  usuario       Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([entidad, entidadId])
  @@index([fecha])
  // Filtro "Usuario" de A20 › Registro de actividad y "último acceso" (D.1.8).
  @@index([usuarioId, fecha])
  @@map("bitacora")
}

// RG-04: ningún valor de negocio fijo en el código.
model Parametro {
  id                Int                  @id @default(autoincrement())
  clave             String               @unique @db.VarChar(80)
  valor             String               @db.VarChar(200)
  unidad            String?              @db.VarChar(30)
  descripcion       String
  // Cómo se muestra en A14 (CU-S05). Los parámetros sin grupo no aparecen en pantalla.
  etiqueta          String?              @db.VarChar(120)
  grupo             String?              @db.VarChar(40)
  // entero | decimal | porcentaje | monto | horario | texto: define cómo se valida y se muestra.
  tipo              String               @default("texto") @db.VarChar(20)
  // Límites del valor (decisiones D.3.4); se ajustan aquí, sin tocar el código.
  minimo            Decimal?             @db.Decimal(12, 2)
  maximo            Decimal?             @db.Decimal(12, 2)
  ayuda             String?              @db.VarChar(300)
  // Solo tipo "opcion": las opciones permitidas, "valor=Etiqueta|valor=Etiqueta" (p. ej. "yd=Yarda|m=Metro").
  opciones          String?              @db.VarChar(200)
  orden             Int                  @default(0)
  modificadoPor     Int?                 @map("modificado_por")
  fechaModificacion DateTime             @default(now()) @map("fecha_modificacion") @db.Timestamptz
  modificador       Usuario?             @relation("ParametroModificadoPor", fields: [modificadoPor], references: [id])
  historial         ParametroHistorial[]

  @@map("parametro")
}

// CU-S05: cada cambio de un parámetro (valor anterior y nuevo, quién y cuándo).
model ParametroHistorial {
  id            Int       @id @default(autoincrement())
  parametroId   Int       @map("parametro_id")
  valorAnterior String    @map("valor_anterior") @db.VarChar(200)
  valorNuevo    String    @map("valor_nuevo") @db.VarChar(200)
  usuarioId     Int       @map("usuario_id")
  fecha         DateTime  @default(now()) @db.Timestamptz
  parametro     Parametro @relation(fields: [parametroId], references: [id])
  usuario       Usuario   @relation(fields: [usuarioId], references: [id])

  @@index([parametroId, fecha])
  @@index([fecha])
  @@map("parametro_historial")
}

// ---------------------------------------------------------------- Comercial · CU-C01 Registrar solicitud de cotización
// Una solicitud puede traer varios muebles (diseño W2): cada uno con su servicio, fotos y telas.

model TipoMueble {
  id      Int               @id @default(autoincrement())
  // Código del dibujo por partes en la web (s3 = sofá de 3 cuerpos, ar = sillón…).
  codigo  String            @unique @db.VarChar(20)
  nombre  String            @unique @db.VarChar(80)
  orden   Int               @default(0)
  activo  Boolean           @default(true)
  partes  TipoMuebleParte[]
  muebles SolicitudMueble[]

  @@map("tipo_mueble")
}

model TipoMuebleParte {
  id           Int             @id @default(autoincrement())
  tipoMuebleId Int             @map("tipo_mueble_id")
  nombre       String          @db.VarChar(60)
  orden        Int
  tipoMueble   TipoMueble      @relation(fields: [tipoMuebleId], references: [id])
  telas        SolicitudTela[]

  @@unique([tipoMuebleId, orden])
  @@map("tipo_mueble_parte")
}

// Inventario (A15 Stock y A15b Telas · CU-A01). Una sola unidad por material, que no cambia una vez que tiene movimientos.
//  - Materiales de stock (espuma, relleno, insumo, pegamento): se cuentan, se reservan y se reponen.
//  - Telas: NO tienen stock; son la copia digital del libro de muestras y se encargan por pedido (encargo_tela).
model Material {
  id            Int                    @id @default(autoincrement())
  codigo        String                 @unique @db.VarChar(30)
  nombre        String                 @db.VarChar(80)
  categoria     String                 @db.VarChar(30) // tela | espuma | relleno | insumo | pegamento
  familia       String?                @db.VarChar(30) // Tipo de tela: Terciopelo, Lino, Pana, Chenille…
  // Color para buscar en el muestrario (Azul, Gris, Beige…).
  colorFamilia  String?                @map("color_familia") @db.VarChar(20)
  libro         String?                @db.VarChar(60) // Libro de muestras donde está la tela
  // Cada tela se identifica por su modelo (pattern) y su número de color.
  pattern       String?                @db.VarChar(20)
  numeroColor   String?                @map("numero_color") @db.VarChar(10)
  colorHex      String?                @map("color_hex") @db.Char(7)
  descripcion   String?                @db.VarChar(160)
  unidadMedida  String                 @map("unidad_medida") @db.VarChar(10)
  proveedorId   Int?                   @map("proveedor_id")
  // Precio por unidad (las telas: por yarda) y desde cuándo rige. Cambiarlo no altera cotizaciones ya enviadas.
  precio        Decimal?               @db.Decimal(10, 2)
  fechaPrecio   DateTime?              @map("fecha_precio") @db.Date
  // Lo que hay en el estante. Solo lo cambian los movimientos (movimiento_inventario guarda el saldo de cada uno).
  stockFisico   Decimal                @default(0) @map("stock_fisico") @db.Decimal(10, 2)
  stockMinimo   Decimal                @default(0) @map("stock_minimo") @db.Decimal(10, 2)
  ubicacion     String?                @db.VarChar(30) // Estante o gaveta
  // Telas: si el cliente la ve en "Telas en línea" (W2). Descontinuar = activo en false (nunca se borra).
  enWeb         Boolean                @default(true) @map("en_web")
  activo        Boolean                @default(true)
  fechaCreacion DateTime               @default(now()) @map("fecha_creacion") @db.Timestamptz
  proveedor     Proveedor?             @relation(fields: [proveedorId], references: [id])
  telas         SolicitudTela[]
  reservas      ReservaMaterial[]
  encargos      EncargoTela[]
  lineasCompra  CompraLinea[]
  movimientos   MovimientoInventario[]
  lineasConteo  ConteoLinea[]

  @@index([categoria, activo])
  @@map("material")
}

// A8p Proveedores: a quién se le compra, cómo se le pide y cuánto tarda (sirve para saber si llega a tiempo).
model Proveedor {
  id            Int        @id @default(autoincrement())
  nombre        String     @unique @db.VarChar(80)
  canal         String     @db.VarChar(12) // telefono | whatsapp
  contacto      String     @db.VarChar(40)
  diasMin       Int        @map("dias_min")
  diasMax       Int        @map("dias_max")
  tipo          String     @db.VarChar(10) // stock | telas (bajo pedido)
  activo        Boolean    @default(true)
  fechaCreacion DateTime   @default(now()) @map("fecha_creacion") @db.Timestamptz
  materiales    Material[]
  compras       Compra[]

  @@map("proveedor")
}

// CU-C14: el pedido nace (con su propio código PED-0000) cuando se acepta la cotización y se paga el adelanto.
// Es distinto de la solicitud (SOL-0000): una solicitud puede no llegar nunca a pedido. Por ahora se enlaza con su
// solicitud de origen; la cotización congelada se agrega con el backend de Cotizaciones.
model Pedido {
  id              Int                    @id @default(autoincrement())
  codigo          String                 @unique @db.VarChar(12)
  solicitudId     Int                    @map("solicitud_id")
  clienteId       Int                    @map("cliente_id")
  // Generado | Esperando mueble | Esperando material | Listo para producir | En producción | En pausa | Terminado |
  // En reparto | Listo para retiro | Entregado | Cerrado | Cancelado (un solo ciclo, RG-09).
  estado          String                 @db.VarChar(30)
  descripcion     String                 @db.VarChar(120) // "Sofá de 3 cuerpos", "12 sillas"…
  fechaCompromiso DateTime?              @map("fecha_compromiso") @db.Date
  fechaCreacion   DateTime               @default(now()) @map("fecha_creacion") @db.Timestamptz
  solicitud       Solicitud              @relation(fields: [solicitudId], references: [id])
  cliente         Cliente                @relation(fields: [clienteId], references: [id])
  reservas        ReservaMaterial[]
  encargos        EncargoTela[]
  movimientos     MovimientoInventario[]

  @@index([estado])
  @@map("pedido")
}

// CU-A02: al nacer el pedido se reservan sus materiales de stock. Reservado = cantidad − retirado (mientras esté activa).
model ReservaMaterial {
  id         Int      @id @default(autoincrement())
  pedidoId   Int      @map("pedido_id")
  materialId Int      @map("material_id")
  cantidad   Decimal  @db.Decimal(10, 2)
  retirado   Decimal  @default(0) @db.Decimal(10, 2)
  activa     Boolean  @default(true)
  fecha      DateTime @default(now()) @db.Timestamptz
  pedido     Pedido   @relation(fields: [pedidoId], references: [id])
  material   Material @relation(fields: [materialId], references: [id])

  @@unique([pedidoId, materialId])
  @@index([materialId, activa])
  @@map("reserva_material")
}

// Tela bajo pedido (A8 · Telas para encargar): aparece cuando se paga el adelanto; al llegar queda en su pedido,
// no entra al stock. por_encargar → encargada → llego.
model EncargoTela {
  id             Int           @id @default(autoincrement())
  pedidoId       Int           @map("pedido_id")
  materialId     Int           @map("material_id")
  cantidad       Decimal       @db.Decimal(10, 2) // yardas
  precio         Decimal       @db.Decimal(10, 2) // por yarda, el cotizado
  estado         String        @db.VarChar(15)
  fechaNecesaria DateTime?     @map("fecha_necesaria") @db.Date
  fecha          DateTime      @default(now()) @db.Timestamptz
  pedido         Pedido        @relation(fields: [pedidoId], references: [id])
  material       Material      @relation(fields: [materialId], references: [id])
  lineas         CompraLinea[]

  @@index([estado])
  @@map("encargo_tela")
}

// CU-A03 / A04: compra al proveedor. Se pide por teléfono o WhatsApp como siempre; GARWEB solo anota
// "Marcar como pedido" (por_llegar) y "Llegó" (llego), que suma al stock.
model Compra {
  id            Int                    @id @default(autoincrement())
  codigo        String                 @unique @db.VarChar(12) // OC-0001
  proveedorId   Int                    @map("proveedor_id")
  estado        String                 @db.VarChar(12) // por_llegar | llego
  fechaPedido   DateTime               @default(now()) @map("fecha_pedido") @db.Timestamptz
  fechaEstimada DateTime?              @map("fecha_estimada") @db.Date
  fechaLlegada  DateTime?              @map("fecha_llegada") @db.Timestamptz
  registradoPor Int                    @map("registrado_por")
  recibidoPor   Int?                   @map("recibido_por")
  proveedor     Proveedor              @relation(fields: [proveedorId], references: [id])
  registrador   Usuario                @relation("CompraRegistradaPor", fields: [registradoPor], references: [id])
  receptor      Usuario?               @relation("CompraRecibidaPor", fields: [recibidoPor], references: [id])
  lineas        CompraLinea[]
  movimientos   MovimientoInventario[]

  @@index([estado])
  @@map("compra")
}

model CompraLinea {
  id         Int          @id @default(autoincrement())
  compraId   Int          @map("compra_id")
  materialId Int          @map("material_id")
  cantidad   Decimal      @db.Decimal(10, 2)
  precio     Decimal      @db.Decimal(10, 2)
  // Solo telas: el encargo que cubre (la tela llega asignada a su pedido).
  encargoId  Int?         @map("encargo_id")
  compra     Compra       @relation(fields: [compraId], references: [id])
  material   Material     @relation(fields: [materialId], references: [id])
  encargo    EncargoTela? @relation(fields: [encargoId], references: [id])

  @@index([materialId])
  @@map("compra_linea")
}

// A8c Movimientos (kardex): toda entrada, salida, ajuste o conteo, con su saldo, quién y cuándo (RG-02, RG-06).
model MovimientoInventario {
  id         Int      @id @default(autoincrement())
  materialId Int      @map("material_id")
  tipo       String   @db.VarChar(10) // entrada | salida | ajuste | conteo
  motivo     String   @db.VarChar(60)
  detalle    String?  @db.VarChar(200)
  cantidad   Decimal  @db.Decimal(10, 2) // con signo: + entra, − sale, 0 = conteo que coincide
  saldo      Decimal  @db.Decimal(10, 2) // en el estante después del movimiento
  pedidoId   Int?     @map("pedido_id")
  compraId   Int?     @map("compra_id")
  conteoId   Int?     @map("conteo_id")
  usuarioId  Int      @map("usuario_id")
  fecha      DateTime @default(now()) @db.Timestamptz
  material   Material @relation(fields: [materialId], references: [id])
  pedido     Pedido?  @relation(fields: [pedidoId], references: [id])
  compra     Compra?  @relation(fields: [compraId], references: [id])
  conteo     Conteo?  @relation(fields: [conteoId], references: [id])
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([materialId, fecha])
  @@index([fecha])
  @@map("movimiento_inventario")
}

// CU-A10 A9: conteo a ciegas. Guarda lo que decía el sistema y lo contado; cada diferencia se ajusta con motivo.
model Conteo {
  id          Int                    @id @default(autoincrement())
  fecha       DateTime               @default(now()) @db.Timestamptz
  usuarioId   Int                    @map("usuario_id")
  usuario     Usuario                @relation(fields: [usuarioId], references: [id])
  lineas      ConteoLinea[]
  movimientos MovimientoInventario[]

  @@map("conteo")
}

model ConteoLinea {
  id         Int      @id @default(autoincrement())
  conteoId   Int      @map("conteo_id")
  materialId Int      @map("material_id")
  sistema    Decimal  @db.Decimal(10, 2)
  contado    Decimal  @db.Decimal(10, 2)
  motivo     String?  @db.VarChar(60)
  conteo     Conteo   @relation(fields: [conteoId], references: [id])
  material   Material @relation(fields: [materialId], references: [id])

  @@unique([conteoId, materialId])
  @@map("conteo_linea")
}

model Direccion {
  id            Int         @id @default(autoincrement())
  clienteId     Int         @map("cliente_id")
  etiqueta      String?     @db.VarChar(40) // Casa, Oficina…
  direccion     String      @db.VarChar(200)
  referencia    String?     @db.VarChar(120)
  ciudad        String?     @db.VarChar(80)
  latitud       Decimal?    @db.Decimal(9, 6)
  longitud      Decimal?    @db.Decimal(9, 6)
  // Una sola principal activa por cliente: lo garantiza el trigger `direccion_una_principal` (migración
  // 20261110180000_perfil_cliente), porque Prisma no maneja índices parciales.
  esPrincipal   Boolean     @default(false) @map("es_principal")
  // Solo las guardadas aparecen en Mi perfil y como opción en la próxima solicitud.
  guardada      Boolean     @default(false)
  activo        Boolean     @default(true)
  fechaCreacion DateTime    @default(now()) @map("fecha_creacion") @db.Timestamptz
  cliente       Cliente     @relation(fields: [clienteId], references: [id])
  recojos       Solicitud[] @relation("SolicitudDireccion")
  citas         Cita[]

  @@index([clienteId])
  @@map("direccion")
}

model Solicitud {
  id              Int               @id @default(autoincrement())
  codigo          String?           @unique @db.VarChar(12) // SOL-0001, se asigna al crearla
  clienteId       Int               @map("cliente_id")
  canal           String            @db.VarChar(20) // web | telefono | local | correo | mensaje
  // trae | catalogo | local | domicilio | sin
  telaOpcion      String            @map("tela_opcion") @db.VarChar(12)
  mismaTela       Boolean           @default(true) @map("misma_tela")
  // Lo que el cliente escribe: la tela que trae o la que busca para la cita o la visita.
  telaDescripcion String?           @map("tela_descripcion") @db.VarChar(200)
  // Pattern y color si ya conoce la tela.
  telaConocida    String?           @map("tela_conocida") @db.VarChar(80)
  // delivery | propio; vacío cuando se define en la cita o la visita.
  traslado        String?           @db.VarChar(12)
  direccionId     Int?              @map("direccion_id")
  fechaPrefRecojo DateTime?         @map("fecha_pref_recojo") @db.Date
  franjaRecojo    String?           @map("franja_recojo") @db.VarChar(10) // manana | tarde
  // Hora preferida de recojo (W2): bloque de `recojo.duracion_min` que reserva la agenda hasta que se acepte o cierre.
  horaPrefRecojo  String?           @map("hora_pref_recojo") @db.VarChar(5)
  estado          String            @db.VarChar(30)
  fechaSolicitud  DateTime          @default(now()) @map("fecha_solicitud") @db.Timestamptz
  registradoPor   Int               @map("registrado_por")
  cliente         Cliente           @relation(fields: [clienteId], references: [id])
  direccion       Direccion?        @relation("SolicitudDireccion", fields: [direccionId], references: [id])
  registrador     Usuario           @relation(fields: [registradoPor], references: [id])
  // Descarte con motivo (CU-C02): nada se borra, queda quién y cuándo.
  motivoDescarte  String?           @map("motivo_descarte") @db.VarChar(120)
  descartadaPor   Int?              @map("descartada_por")
  fechaDescarte   DateTime?         @map("fecha_descarte") @db.Timestamptz
  descartador     Usuario?          @relation("SolicitudDescartadaPor", fields: [descartadaPor], references: [id])
  // El Administrador pidió las fotos por enlace (A3): no se cotiza hasta que lleguen.
  esperaFotos     Boolean           @default(false) @map("espera_fotos")
  muebles         SolicitudMueble[]
  citas           Cita[]
  notificaciones  Notificacion[]
  pedidos         Pedido[]

  @@index([clienteId, fechaSolicitud])
  @@index([estado])
  @@map("solicitud")
}

model SolicitudMueble {
  id           Int                @id @default(autoincrement())
  solicitudId  Int                @map("solicitud_id")
  orden        Int
  tipoMuebleId Int                @map("tipo_mueble_id")
  // retapizado | retapizado_espuma | espuma | estructura | fabricacion
  servicio     String             @db.VarChar(20)
  acabado      String?            @db.VarChar(12) // solo fabricación: liso | capitoneado | canales
  cantidad     Int                @default(1)
  medidas      String?            @db.VarChar(120)
  modoTela     String?            @map("modo_tela") @db.VarChar(10) // una | partes (telas del catálogo)
  solicitud    Solicitud          @relation(fields: [solicitudId], references: [id])
  tipoMueble   TipoMueble         @relation(fields: [tipoMuebleId], references: [id])
  telas        SolicitudTela[]
  adjuntos     SolicitudAdjunto[]

  @@unique([solicitudId, orden])
  @@map("solicitud_mueble")
}

model SolicitudTela {
  id                Int              @id @default(autoincrement())
  solicitudMuebleId Int              @map("solicitud_mueble_id")
  materialId        Int              @map("material_id")
  parteId           Int?             @map("parte_id") // con "distintas telas por partes"
  orden             Int
  mueble            SolicitudMueble  @relation(fields: [solicitudMuebleId], references: [id])
  material          Material         @relation(fields: [materialId], references: [id])
  parte             TipoMuebleParte? @relation(fields: [parteId], references: [id])

  @@map("solicitud_tela")
}

model SolicitudAdjunto {
  id                Int             @id @default(autoincrement())
  solicitudMuebleId Int             @map("solicitud_mueble_id")
  tipo              String          @db.VarChar(10) // foto | video
  nombreOriginal    String          @map("nombre_original") @db.VarChar(160)
  // Ruta dentro del almacén de archivos (disco en Docker; Supabase Storage en producción).
  ruta              String          @db.VarChar(200)
  mime              String          @db.VarChar(60)
  tamanoBytes       Int             @map("tamano_bytes")
  fechaSubida       DateTime        @default(now()) @map("fecha_subida") @db.Timestamptz
  mueble            SolicitudMueble @relation(fields: [solicitudMuebleId], references: [id])

  @@map("solicitud_adjunto")
}

// ---------------------------------------------------------------- RG-05: todo lo que se avisa por correo también queda aquí
model Notificacion {
  id          Int        @id @default(autoincrement())
  usuarioId   Int        @map("usuario_id")
  solicitudId Int?       @map("solicitud_id")
  tipo        String     @db.VarChar(40)
  titulo      String     @db.VarChar(120)
  mensaje     String     @db.VarChar(400)
  // Ruta de la web donde se atiende el aviso (p. ej. /cliente/pedidos/solicitudes).
  enlace      String?    @db.VarChar(200)
  leida       Boolean    @default(false)
  fecha       DateTime   @default(now()) @db.Timestamptz
  usuario     Usuario    @relation(fields: [usuarioId], references: [id])
  solicitud   Solicitud? @relation(fields: [solicitudId], references: [id])

  @@index([usuarioId, leida, fecha])
  @@map("notificacion")
}

// ---------------------------------------------------------------- CU-C03 / C04: agenda de citas en el local y visitas a domicilio
model Cita {
  id               Int        @id @default(autoincrement())
  solicitudId      Int        @map("solicitud_id")
  tipo             String     @db.VarChar(12) // local | domicilio
  // Cita en el local: hora exacta del turno. Visita: el día a las 00:00 y la franja aparte.
  fechaHora        DateTime   @map("fecha_hora") @db.Timestamptz
  franja           String?    @db.VarChar(10) // manana | tarde (solo visitas)
  duracionMin      Int        @map("duracion_min")
  direccionId      Int?       @map("direccion_id") // dónde es la visita
  reprogramaciones Int        @default(0)
  estado           String     @db.VarChar(20) // Programada | Atendida | No asistió | Reprogramada | Cancelada
  observaciones    String?    @db.VarChar(300)
  registradoPor    Int        @map("registrado_por")
  fechaRegistro    DateTime   @default(now()) @map("fecha_registro") @db.Timestamptz
  solicitud        Solicitud  @relation(fields: [solicitudId], references: [id])
  direccion        Direccion? @relation(fields: [direccionId], references: [id])
  registrador      Usuario    @relation(fields: [registradoPor], references: [id])

  @@index([fechaHora, estado])
  @@index([solicitudId])
  @@map("cita")
}

// Días u horas en que el taller no atiende citas (feriados, cierres). Los administra la Agenda (A2).
model AgendaBloqueo {
  id            Int       @id @default(autoincrement())
  fecha         DateTime  @db.Date
  horaInicio    String?   @map("hora_inicio") @db.VarChar(5) // vacío = todo el día
  horaFin       String?   @map("hora_fin") @db.VarChar(5)
  motivo        String    @db.VarChar(120)
  creadoPor     Int?      @map("creado_por")
  fechaCreacion DateTime  @default(now()) @map("fecha_creacion") @db.Timestamptz
  // Quitar un bloqueo no lo borra: queda anulado, con quién y cuándo (A2 · Configurar agenda).
  activo        Boolean   @default(true)
  quitadoPor    Int?      @map("quitado_por")
  fechaQuitado  DateTime? @map("fecha_quitado") @db.Timestamptz

  @@index([fecha])
  @@map("agenda_bloqueo")
}
