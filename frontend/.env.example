# URL base de la API de GARWEB. En desarrollo, /api pasa por el proxy de Vite a http://localhost:3000.
# Si se deja vacía, el frontend usa la API simulada en memoria (src/features/seguridad/api/authMock.ts).
VITE_API_URL=/api

# Google Maps (mapa y autocompletado de direcciones). Clave de navegador restringida a sus dominios.
# APIs a habilitar en Google Cloud: "Maps JavaScript API" y "Places API (New)" (la dirección al tocar el mapa sale de OpenStreetMap, sin clave). Sin clave se ve un mapa ilustrado.
VITE_GOOGLE_MAPS_API_KEY=
# Map ID (Google Cloud > Map Management). Vacío = DEMO_MAP_ID, solo para desarrollo.
VITE_GOOGLE_MAPS_MAP_ID=

# Stripe (opcional por ahora): con Stripe Checkout el pago se hace en la página de Stripe y el frontend no necesita esta clave.
# Si más adelante se usa el formulario de tarjeta dentro de GARWEB, va la clave PUBLICABLE (pk_test_…), nunca la secreta.
VITE_STRIPE_PUBLISHABLE_KEY=
